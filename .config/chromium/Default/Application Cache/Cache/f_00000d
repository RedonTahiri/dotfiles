// //////////////////////////////////////////////////////////////////////////
/* eslint-env worker */
// disable eslint es6 specific errors because this file is not transpiled
/* eslint no-var: off, prefer-rest-params: off, object-shorthand: off, prefer-template: off, prefer-arrow-callback: off */

// this global object is used to communicate with the emscripten compiled simulator
// window.Module does not work in this case, hence eslint-disable-line no-implicit-globals
var Module = null; // eslint-disable-line no-implicit-globals

// this is the javascript worker that uses the emscripten compiled version of the simulator do do simulations
(function workerMain() {
	var m_Data = null;
	var m_Set = [];						// a single set of values that all belong to a single time step
	var m_bMustSendData = false;		// indicates that data is available for retrieval
	var m_bSimulationActive = false;	// indicates if a simulation is currently running
	var m_bFinished = false;			// indicates if we are done
	var m_Paused = false;				// indicates if the simulator is paused or not
	var m_StopRequested = false;		// indicates a stop has been requested
	// var StringInfo = null;				// will hold the stringfile information
	var lastDataRetrieve = null;		// the last time data was retrieved by the client

	// these items are used to get a better (percieved)performance by using an interval mode
	var m_TimeoutCount = 1;				// number of timeouts to insert
	var m_TimeoutTime = 0;				// the length of a timeout (note: 0 doesn't actually mean that it will wait 0 seconds, since there is a minimal timeout time)
	var m_TimeStepBatchSize = 10;		// number of time steps to batch together, this value will be dynamically modified during a simulation run to try and maintain a 20 fps return rate
	var m_bIntervalMode = false;		// indicates if we use the interval mode or not, in interval mode we batch up timesteps and insert some strategic timeouts to improve performance
	// it sounds contradictory that we insert timeouts to improve performance but this has to do with maintaining responsiveness while simulating
	// timeouts give the message system the chance to process any messages

	// clear the data arrays
	function resetDataArray() {
		m_Data = { event: 'outpdata', data: [] };
	}
	resetDataArray();

	// send data back to the parent
	function sendData() {
		// if a stop was requested we clear any remaining data
		if (m_StopRequested) {
			m_bMustSendData = false;
			resetDataArray();
		}
		else {
			// we stop sending data as soon as a pause or a stop is requested
			if (m_Data.data.length && !m_Paused) {
				m_bMustSendData = false;

				self.postMessage(m_Data);
				resetDataArray();
				lastDataRetrieve = new Date();
			}
			else {
				m_bMustSendData = true;
			}
		}
	}

	// request new timepoints
	// @param {string} p_ID : Some id to match messages with their return values
	function nextTimePoints(p_ID) {
		if (Module !== null && m_bSimulationActive && !m_Paused) {
			var TimePointBatchSize = m_TimeStepBatchSize,
			TimePointCount = 0,
			StartTime = new Date();

			if (!lastDataRetrieve || StartTime.getTime() - lastDataRetrieve.getTime() < 1000){
				// get the next step as long as the number of points is smaller then the batch size
				while (!m_bFinished && TimePointCount < TimePointBatchSize) { // eslint-disable-line no-unmodified-loop-condition
					Module.ccall('NextStep', '', [''], []);
					TimePointCount++;
				}

				// dynamically change the number of time steps we calculate per time step request
				var EndTime = new Date();

				var Diff = Math.max(1, EndTime.getTime() - StartTime.getTime());
				var TimepointsPerms = m_TimeStepBatchSize / Diff;
				// if the time between results is bigger then 30 ms or the time is smaller then 10 ms we will adjust the number of steps calculated
				// the target is 20 ms between result batches to get 50 FPS
				if (Diff > 30 || Diff < 10) {
					m_TimeStepBatchSize = Math.max(1, Math.floor(TimepointsPerms * 20));
					// notify the worker owner of the time step change
					self.postMessage({ event: 'timepointbatchsizechange', timepointbatchsize: m_TimeStepBatchSize });
				}
			}

			if (m_bSimulationActive) {
				// if the simulation is finished we have to do cleanup
				if (m_bFinished) {
					Module.ccall('FinishSimulation', '', [''], []);
					m_bSimulationActive = false;
					self.postMessage({ event: 'done', id: p_ID, result: 'finished' });
				}
				else {
					// else keep asking for new time points
					var handleTimeOut = function() {
						nextTimePoints(p_ID);
					};

					if (!m_bIntervalMode) {
						self.postMessage({ event: 'done', id: p_ID, result: 'moretimepoints' });
					}
					else {
						for (var Index = 1; Index < m_TimeoutCount; Index++) {
							setTimeout(handleTimeOut, m_TimeoutTime);
						}
					}
					setTimeout(handleTimeOut, m_TimeoutTime);
				}
			}
		}
		else if (!m_Paused) {
			if (Module === null) {
				self.postMessage({ event: 'done', id: p_ID, result: 'error', description: 'The simulator was not initialized' });
			}
			else if (!m_bSimulationActive) {
				self.postMessage({ event: 'done', id: p_ID, result: 'error', description: 'The simulator was not started' });
			}
		}
	}

	// handle messages that are being send to this worker from the parent
	// @param {Object} p_Param : The data send from the parent
	self.onmessage = function(p_Param) {
		var Message = p_Param.data;

		switch (Message.command) {
		case 'initialize':
			// create the interface to the simulator, see also mslib.js inside of the xspicecontrol project
			Module = {
				// when debug messages are enabled, this function will be called by the simulator with any debug messages
				// @param {string} p_Type : The type of message (e.g. error, warning, info)
				// @param {string} p_Message : The message that was send back from the simulator
				debugMessage: function debugMessage(p_Type, p_Message) {
					switch (p_Type) {
					case 'error': console.error(p_Message);
						break;
					case 'warning' : console.warn(p_Message);
						break;
					default: console.log(p_Message);
						break;
					}
				},
				// handle a spice error message coming from the simulator
				spiceErrorMessage: function spiceErrorMessage(type, message) {
					self.postMessage({
						event: 'spiceerrormessage',
						errorType: type,
						message: message,
					});
				},
				// will be called by simulator when the lists were retrieved from the simulatior
				// @param { object} p_Lists : contains the requested lists
				sendLists: function(p_Lists) {
					self.postMessage({ event: 'sendlists', data: p_Lists });
				},
				// this groups together interfaces related with simulation data
				plotter: function() {
					return {
						// handle the outPBeginPlot message from the simulator, which is send at the start of a simulation
						// @param {string} p_Names: comma separated list of nodes that represent the data that will be returned from the simulator
						// @param {object} p_Data: Extended information for nodes and aliases
						outPBeginPlot: function outPBeginPlot(p_Names, p_Data) {
							m_bFinished = false;
							resetDataArray();				// clear any existing data
							m_bMustSendData = false;

							// forward this data to the worker's owner
							self.postMessage({ event: 'outpbeginplot', names: p_Names, data: p_Data });
						},
						// handle the outPEndPlot message from the simulator, which is send at the end of a simulation
						outPEndPlot: function outPEndPlot(p_Data) {
							if (p_Data.endplotdata.lastSweep) {
								m_bFinished = true;
								sendData(); // send any remaining data to the parent first
								self.postMessage({ event: 'outpendplot', data: p_Data }); // then forward this message to the parent
							} else {
								sendData(); // send any remaining data to the parent first
							}
						},
						// store any time point values
						// @param {double} p_Value : A single value belonging to a time step
						// these will be received in the same order as the names that were passes to the outPBeginplot message
						outPDataSetValue: function outPDataSetValue(p_Value) {
							m_Set.push(p_Value);
						},
						outPDataSetDigitalValue: function outPDataSetDigitalValue(p_Node, p_Time, p_Value, p_OldValue) {
							m_Set.push({ node: p_Node, time: p_Time, value: p_Value, oldvalue: p_OldValue });
						},
						// notifies that we have reached the end of a set of data values
						outPDataSetEnd: function outPDataSetEnd() {
							// we ignore data that comes in after a stop was requested
							if (!m_StopRequested) {
								// send a data available message if we currently have no data (we will have after this function completes)
								// and we don't already have a request to send the data
								if (!m_Data.data.length && !m_bMustSendData) {
									// notify the client that new data is available
									self.postMessage({ event: 'dataavailable' });
								}
								// add the new data set which represents all values for a single timestep
								m_Data.data.push(m_Set);
							}
							// reset the set back to empty
							m_Set = [];
							// if a data request has been received already, send it immediately
							if (m_bMustSendData) {
								sendData();
							}
						},
					};
				},
				// retrieve string messages from the string resources
				getResourceString: function getResourceString(p_ProjectID, p_ResourceID) {
					// TODO: retrieve string information from string files here
					return p_ResourceID;
				},
				appLoadReady: function() {
					self.postMessage({ event: 'done', id: Message.id, result: 'success' });
				},
				// emscripten specific functions, see emscripten documentation for details
				preRun: [],
				postRun: [],
				noInitialRun: false,
				noExitRuntime: true,
				// called when a printf call is made within the emscripten compiled c++ code
				print: (function() {
					return function(text) {
						text = Array.prototype.slice.call(arguments).join(' ');
						console.log(text);
					};
				})(),
				printErr: function printErr(text) {
					text = Array.prototype.slice.call(arguments).join(' ');
					console.log(text);
				},
				setStatus: function setStatus(text){
					var now = Date.now();
					if (!Module.setStatus.last || text !== Module.setStatus.text){
						// if this is a progress update, skip it if too soon
						if (!Module.setStatus.last || Date.now() - Module.setStatus.last.time >= 30){
							self.postMessage({ event: 'status', message: text });
						}
					}

					Module.setStatus.text = text;
					Module.setStatus.last = { time: now, text: text };
				},
				totalDependencies: 0,
				monitorRunDependencies: function(left){
					this.totalDependencies = Math.max(this.totalDependencies, left);
					Module.setStatus(left ? 'Preparing ... (' + (this.totalDependencies - left) + '/' + this.totalDependencies + ')' : 'All downloads complete.');
				},
			};
			Module.setStatus('Downloading ...');

			try {
				// load the emscripten javascript file
				importScripts(Message.simsource || 'xspicecontrol_release.js');
				console.log('done importing');
			}
			catch (e) {
				// send back the error information
				self.postMessage({ event: 'done', id: Message.id, result: 'error', message: e.message + ' stack: ' + JSON.stringify(e.stack) });
			}

			Module.setStatus('Downloading text ...');

			// load the strings to be used with the simulator
			var Req = new XMLHttpRequest();
			Req.onload = function() {
				if (this.readyState == 4 && this.status == 200) {
					// if the strings were loaded successfully, notify that the worker is ready
					// StringInfo = JSON.parse(this.responseText);
					Module.setStatus('Initializing simulator ...');
				}
			};

			Req.open('get', '../i18n/english/stringfiles.json', true);
			Req.send();
			break;
		// handle a retrieve data request send by the parent
		case 'retrievedata':
			sendData();
			break;
		// handle a stop simulation request as send by the parent
		case 'stopsimulation':
			if (m_bSimulationActive) {
				m_StopRequested = true;
				m_bSimulationActive = false; // no longer active simulation

				Module.ccall('StopSimulation', '', [''], []);

				if (m_Paused) {
					m_Paused = false;
					nextTimePoints(Message.id);
				}

				self.postMessage({ event: 'done', id: Message.id, result: 'success' });
			}
			break;
		// handle a start simulation request as send by the parent
		// start simulation is used for interactive simulations where any new time points have to be specifically requested by the nexttimepoints message
		case 'startsimulation':
			if (!m_bSimulationActive) {
				m_Paused = false;
				m_StopRequested = false;
				lastDataRetrieve = null;

				if (Module !== null) {
					Module.ccall('StartSimulation', '', ['string', 'string', 'string', 'number', 'number'], [Message.netlist, Message.spicecommands.initialize.join('\n'), Message.spicecommands.start, true, 0]);
					m_bSimulationActive = true;
					m_bIntervalMode = (typeof Message.intervalmode != 'undefined') ? Message.intervalmode : true;
					m_TimeoutCount = Math.max(1, Message.timeoutcount || 1);
					m_TimeStepBatchSize = Math.max(1, Message.timestepbatchsize || 10);
					m_TimeoutTime = Math.max(0, (typeof Message.timeouttime != 'undefined') ? Message.timeouttime : 0);

					self.postMessage({ event: 'done', id: Message.id, result: 'success' });
				}
				else {
					self.postMessage({ event: 'done', id: Message.id, result: 'error', description: 'The simulator was not initialized' });
				}
			}
			else {
				self.postMessage({ event: 'done', id: Message.id, result: 'error', description: 'The simulator is already running' });
			}
			break;
		// handle a run simulation request as send by the parent
		// run simulation will run a simulation from start to finish without waiting for nexttimepoint messages, this type of simulation will not handle messages that
		// come in during the simulation
		case 'runsimulation':
			if (!m_bSimulationActive) {
				m_Paused = false;
				m_StopRequested = false;
				if (Module !== null) {
					Module.ccall('StartSimulation', '', ['string', 'string', 'string', 'number', 'number'], [Message.netlist, Message.spicecommands.initialize.join('\n'), Message.spicecommands.start, false, 0]);

					self.postMessage({ event: 'done', id: Message.id, result: 'success' });
				}
				else {
					self.postMessage({ event: 'done', id: Message.id, result: 'error', description: 'The simulator was not initialized' });
				}
			}
			else {
				self.postMessage({ event: 'done', id: Message.id, result: 'error', description: 'The simulator is already running' });
			}
			break;
			// pause any currently running simulation
		case 'pausesimulation':
			if (m_bSimulationActive) {
				m_Paused = true;
				self.postMessage({ event: 'done', id: Message.id, result: 'success' });
			}
			else {
				self.postMessage({ event: 'done', id: Message.id, result: 'error', description: 'No simulation was active' });
			}
			break;
			// resume a paused simulation
		case 'resumesimulation':
			// only do this if we are actually paused
			if (m_Paused) {
				lastDataRetrieve = null;
				m_Paused = false;
				nextTimePoints(Message.id);
				self.postMessage({ event: 'done', id: Message.id, result: 'success' });
			}
			else {
				self.postMessage({ event: 'done', id: Message.id, result: 'error', description: 'Simulation was not paused' });
			}
			break;
		// request the next set of timepoints, can only be used in combination with start simulation
		case 'nexttimepoints':
			nextTimePoints(Message.id);
			break;
		case 'unload':
			// destroy simulator content ???
			break;
		// change the values of a specific component/model
		case 'changevalue':
			var ChangeInfoKeys = Object.keys(Message.valueinfo);

			ChangeInfoKeys.forEach(function(p_Key) {
				var ChangeInfo = Message.valueinfo[p_Key];

				var indexedParameters = ChangeInfo.parameters.parameters.filter(function(p_Parameter){ return p_Parameter.hasOwnProperty('index'); });
				var namedParameters = ChangeInfo.parameters.parameters.filter(function(p_Parameter){ return !p_Parameter.hasOwnProperty('index') && p_Parameter.hasOwnProperty('name'); });
				// var values = [];

				indexedParameters.forEach(function(p_IndexedParam){
					// values.push([p_IndexedParam.index, p_IndexedParam.value]);
					var inst = ChangeInfo.instance_name;

					if (p_IndexedParam.subInstance) {
						// Changing sub instance parameter
						inst = p_IndexedParam.subInstance + ':' + inst;
					}

					var model = ChangeInfo.model_name;

					if (p_IndexedParam.subModel) {
						model = p_IndexedParam.subModel;
					}

					var valueString = '' + p_IndexedParam.index + ',' + p_IndexedParam.value;
					Module.ccall('UpdateModelInstanceArrayValueWithDeviceName', '', ['string', 'string', 'string', 'string', 'number', 'string'], [ChangeInfo.device_name, inst, model, indexedParameters[0].name, 0, valueString]);
				});

				/* if (values.length){
					var valueString = values.map(function(p_Pair){ return p_Pair.join(','); }).join("|");
					Module.ccall('UpdateModelInstanceArrayValueWithDeviceName', '', ['string', 'string', 'string', 'string', 'number', 'string'], [ChangeInfo.device_name, ChangeInfo.instance_name, ChangeInfo.model_name, indexedParameters[0].name, 0, valueString]);
				}*/

				namedParameters.forEach(function(p_NamedParam){
					var inst = ChangeInfo.instance_name;

					if (p_NamedParam.subInstance) {
						// Changing sub instance parameter
						inst = p_NamedParam.subInstance + ':' + inst;
					}

					var model = ChangeInfo.model_name;

					if (p_NamedParam.subModel) {
						model = p_NamedParam.subModel;
					}

					if (ChangeInfo.instance_name){
						Module.ccall('SetModelInstanceValueWithDeviceName', '', ['string', 'string', 'string', 'string', 'number', 'number'], [ChangeInfo.device_name, inst, model, p_NamedParam.name, 0, p_NamedParam.value]);
					}
					else {
						Module.ccall('SetModelValueWithDeviceName', '', ['string', 'string', 'string', 'number'], [ChangeInfo.device_name, model, p_NamedParam.name, p_NamedParam.value]);
					}
				});
			});
			break;
		// enable or disable debug messages
		case 'debugmessages':
			Module.ccall('SetDebugMessages', '', ['number'], [Message.value]);
			break;
		// request node, device parameters and model lists
		case 'requestlists':
			Module.ccall('GetListsForNetlist', '', ['string', 'string', 'string'], [Message.lists.join(','), Message.netlist, Message.parameters.join(',')]);
			break;
		}
	};
})();
