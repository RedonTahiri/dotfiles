			}

			.inputDiv
			{
				-webkit-flex-basis: var(--multisim-nounit-input-width, 120px);
				flex-basis: var(--multisim-nounit-input-width, 120px);
			}

			.multisimInputLabel {
				-webkit-flex-grow: 1;
				flex-grow: 1;
			    @apply(--multisim-input-label-styles);
			}

