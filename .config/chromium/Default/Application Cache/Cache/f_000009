					padding: 0;
					width: 24px;
					height: 100%;
				}
			}

			:host([child-expanded]) #backarrow {
				display: block;
			}

		</style>
		<div class="popout" id="popout">
			<div class="trianglearea">
				<div class="abovearrow"></div>
				<div class="arrow">
					<div class="topheadertriangle"><div class="topheadertriangle"></div></div>
					<div class="bottomheadertriangle"><div class="bottomheadertriangle"></div></div>
					<div class="arrowwrap">
						<div class="arrowright"><div class="arrowright"><div class="topline"><div class="bottomline"></div></div></div></div>
					</div>
				</div>
				<div class="belowarrow"></div>
			</div>
			<div class="popoutheader">
				<div class="bottomborder"></div>
				<div class="titlecontainer"><span id="titleSpan" class="title"></span></div>
				<paper-icon-button id="backarrow" icon="multisim:leftshevron"></paper-icon-button>
			</div>
			<div id="scrollContainer">
				<div id="childContainer">
				</div>
			</div>
		</div>
