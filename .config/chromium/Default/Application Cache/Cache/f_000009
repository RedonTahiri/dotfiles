			{
				box-sizing: border-box;
				position: relative;
			    -webkit-flex: 0 0 30px;
			    flex: 0 0 30px;
			}

			.trianglearea .abovearrow
			{
			    -webkit-flex: 0 1 0;
			    flex: 0 1 0;
			}

			.trianglearea .belowarrow
			{
			    -webkit-flex: 1 1 auto;
			    flex: 1 1 auto;
			}

			.popoutheader .titlecontainer
			{
				display: -webkit-flex;
				display: flex;
				position: relative;
				height: 100%;
				margin-left: 1em;
				-webkit-flex: 1 1 auto;
				flex: 1 1 auto;
				overflow: hidden;
			}

			.popoutheader .bottomborder
			{
				position: absolute;
				top: 0;
				bottom: -1px;
				left: -15px;
				width: 16px;
				border-bottom: 1px solid gray;
			}

			.title
			{
			    -webkit-align-self: center;
			    align-self: center;
			}

			.arrowwrap
			{
				position: absolute;
			}

			.arrowwrap > .arrowright
			{
				top: -1px;
				left: -5px;
			}

			.arrowwrap > .arrowright > .arrowright
			{
				top: -16px;
				left: -17px;
				border-left: 16px solid #eee;
			}

			.topheadertriangle
			{
				position: absolute;
				width: 0;
				height: 0;
				border-top: 16px solid gray;
				border-right: 16px solid transparent;
				border-left: 16px solid transparent;
				top: 0;
				left: 0;
			}

			.topheadertriangle > .topheadertriangle
			{
				top: -16px;
				left: -15px;
				border-top-color: #eee;
			}

			.bottomheadertriangle
			{
				position: absolute;
				width: 0;
				height: 0;
				border-bottom: 16px solid gray;
				border-right: 16px solid transparent;
				border-left: 16px solid transparent;
				top: 14px;
				left: 0;
			}

			.bottomheadertriangle > .bottomheadertriangle
			{
				left: -15px;
				top: 0;
				border-bottom-color: #eee;
			}

			.titlecontainer .title{
				overflow: hidden;
				text-overflow: ellipsis;
			}

			#scrollContainer {
				overflow-y: hidden;
			}

			#scrollContainer.showbar {
				overflow-y: scroll;
			}

			#childContainer
			{
				display: -webkit-flex;
				display: flex;

				padding: 3px;

				-webkit-flex-direction: row;
				flex-direction: row;
				-webkit-flex-wrap: wrap;
				flex-wrap: wrap;
				-webkit-align-content: stretch;
				align-content: stretch;
				-webkit-align-items: flex-start;
				align-items: flex-start;
			}

			.portrait #childContainer
			{
				-webkit-flex-direction: column;
				flex-direction: column;
			}

			.itemContainer
			{
				margin: 0px;
			}

			.itemContainer ::content .tileContainer .tile
			{
				box-sizing: border-box;
			}

			.itemContainer ::content .tileContainer #textContainer
			{
				box-sizing: border-box;
				width: 70px;
			}

			.titlecontainer {
				pointer-events: none;
				display: block;
				@apply(--multisim-select-and-drag-cursor)
			}

			#backarrow.button {
				pointer-events: all;
			}

			#backarrow.button:hover {
				background: var(--multisim-button-hover-background, white);
