<script>

	// Use this file to add 'small help'. Need to do the following:
	//
	// in the js file, in window.Polymer, add:
	//		"behaviors: [window.Polymer.InitializeHelp]," to the window.Polymer struct
	// in the js file, in the initialization function, add:
	//		this.behaviors[0]._initializeHelpAsync(_this, window.multisim.rootFolder + 'resources/help_en/help-sheet-settings.json');
	// in the html file, add:
	//		<link rel="import" href="../../components/behaviors/initialize-help.html">

	window.Polymer.InitializeHelp = {

	properties: {
		isHighlighted: {
			type: Boolean,
			value: false,
			notify: true,
		},
		helpActivated: {
			type: Boolean,
			value: false,
			notify: true,
			reflectToAttribute: true,
			observer: '_helpChanged'
		}
	},

	_initializeHelpAsync: function(document, filename) {
		return fetch(filename)
				.then((response) => response.json())
				.then((helpDefinitions) => {
					const htmlHelpItems = Array.from(document.querySelectorAll("multisim-small-help"));
					const htmlInfoItems = Array.from(document.querySelectorAll(".paramfullname"));
					if (helpDefinitions) {
						htmlHelpItems.forEach(function (htmlItem, i) {
							let helpDef;
							if (htmlItem.parameter !== null) {
								helpDef = helpDefinitions[htmlItem.parameter];
								if (helpDef) {
									htmlItem.label = helpDef.SmallHelp;
								}
								else {
									if (window.multisim.versionInfo.isDevelopment) {
										htmlItem.label = "< Help id=" + htmlItem.parameter + " >";
									}
								}
							}
						});
						// Add 'info' from the json file.
						htmlInfoItems.forEach(function (htmlItem, i) {
							let infoDef;
							if (htmlItem.id !== "") {
								infoDef = helpDefinitions[htmlItem.id];
								if (infoDef) {
									htmlItem.innerHTML = infoDef.Info;
								}
							}
						});
					}
				});
	},

	_acquireHelp: function(document) {
		document.helpItems = document.querySelectorAll("multisim-small-help");
		if (document.helpItems && document.helpItems.length > 0 ) {
			document.$.smallHelp.classList.add("showicon");
			this._helpChanged();
		}
		else {
			document.$.smallHelp.classList.remove("showicon");
		}
	},

	_helpChanged: function () {
		if (this.helpItems && this.helpItems.length > 0) {
			var i;
			for(i = 0; i < this.helpItems.length; ++i){
				this.helpItems[i].visible = this.helpActivated;
			}
		}
	}


    };

</script>
