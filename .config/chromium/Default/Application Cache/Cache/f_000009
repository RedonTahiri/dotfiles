<dom-module id="object-palette-tile" assetpath="../object-palette/">
	<template>
		<style>
			.tileContainer
			{
				position: relative;
				margin-left: auto;
				margin-right: auto;
				box-sizing: border-box;
				@apply(--multisim-object-palette-tile-style);
			}

			.tileContainer:hover
			{
				border-color: var(--multisim-object-palette-hover-border-color, rgb(67, 134, 185));
				background-color: var(--multisim-background-color, transparent);
				@apply(--multisim-select-and-drag-cursor);
			}

			:host(.textinline) #tile {
				display: -webkit-flex;
				display: flex;
				-webkit-flex-direction: row;
				flex-direction: row;
			    -webkit-flex-wrap: nowrap;
			    flex-wrap: nowrap;
			    -webkit-justify-content: flex-start;
			    justify-content: flex-start;
			    -webkit-align-content: stretch;
			    align-content: stretch;
			    -webkit-align-items: center;
			    align-items: center;
			}

			:host(.textinline) #textContainer {
			    text-align: left;
			    text-overflow: ellipsis;
			    padding-left: 5px;
			}

			:host(.textinline) #tile div:first-child {
				-webkit-flex: 0 0 40px;
				flex: 0 0 40px;
				margin: 0;
				/* firefox 45 doesn't seem to handle the flex box size properly so force the sizes here */
				max-width: 40px;
				min-width: 40px;
				max-height: 28px;
				min-height: 28px;
			}

			:host([expanded]) > .tileContainer
			{
				border-color: var(--multisim-object-palette-selected-border-color, black);
			}

			.child {
				position: absolute;
				top: 0;
				bottom: 0;
				left: 0;
				right: 0;
				display: none;
			}

			:host([expanded]) > .tileContainer > .child {
				display: block;
				visibility: visible;
			}

			:host([expanded]) > .tileContainer > .tile {
				height: 30px;
			}

			:host([expanded]) > .tileContainer > .child > object-palette-popout {
				pointer-events: all;
			}

			#imageContainer
			{
				padding-top: 2px;
				position: relative;
				width: 48px;
				margin-left: auto;
				margin-right: auto;
				@apply(--multisim-object-palette-imagecontainer-styles);
			}

			#textContainer
			{
				text-align: center;
				font-size: 12px;
			}

			.dragarea {
				visibility: hidden;
				position: absolute;
				left: 0;
				top: 0;
				width: 100%;
				height: 100%;
			}

			.dragarea.active {
				visibility: visible;
				position: fixed;
				left: 0px;
				top: 0px;
				right: 0px;
				bottom: 0px;
				pointer-events: all;
				z-index: 1;
			}

			:host:not(.probe) .tileContainer g  {
				stroke: var(--multisim-palette-icon-color, black);
				fill: var(--multisim-palette-icon-color, black);
			}

			.foldericon {
				display: none;
				position: absolute;

				--layout-center-center :{
					left: 0;
					top: 0;
					right: 0;
					bottom: 0;
				}
				--iron-icon-height: null;
				--iron-icon-width: null;
			}

			:host(.folder) > .tileContainer > .tile > #imageContainer > .foldericon {
				display: block;
			}

			:host(.folder[level="0"]) > .tileContainer > .tile > #imageContainer > .foldericon {
				display: none;
			}

			#tile {
			    pointer-events: none;
			}
		</style>
		<div class="tileContainer">
			<div class="dragarea"></div>
			<div id="tile" class="tile">
				<div id="imageContainer"><iron-icon class="foldericon" icon="multisim:palettefolder"></iron-icon></div>
				<div id="textContainer"></div>
			</div>

			<div id="childContent" class="child">
				<!-- if this tile represents a folder, this child content get sucked in here -->

			</div>
		</div>
	</template>
</dom-module>

<dom-module id="object-palette-popout" assetpath="../object-palette/">
	<template>
		<style type="text/css">
			.arrowright
			{
				position: relative;
				width: 0;
				height: 0;
				border-top: 16px solid transparent;		/* the triangle will be 30 px high which means 15px on top and bottom */
				border-bottom: 16px solid transparent;
				border-left: 16px solid gray;
			}

			.popoutheader,
			#scrollContainer
			{
				position: relative;
				margin-left: 22px;
				border: 1px solid gray;
				border-left: none;
				background-color: #eee;
				box-sizing: border-box;
				padding-left: 0;
			}

			.popoutheader
			{
				height: 32px;
				border-bottom: none;
				display: -webkit-flex;
				display: flex;
				white-space: nowrap;
			}

			:host([child-expanded]) > .popout,
			:host([child-expanded]) > .popout > #scrollContainer,
