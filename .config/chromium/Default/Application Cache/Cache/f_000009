				margin: 0;
				padding: 0;
				border: 0;
				overflow: hidden;
				visibility: hidden;
				position: absolute;
				top: 0;
				right: 0;
				left: 0;
				bottom: 0;
				pointer-events: none;
			}

			:host([child-expanded]) > .popout > #scrollContainer > #childContainer > .itemContainer > object-palette-tile
			{
				position: absolute;
				top: -2px;
				left: -2px;
				right: 0;
				overflow: hidden;
